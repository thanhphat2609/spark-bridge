# =============================================================================
# SparkBridge on YARN - Azure environment
# Copy to .env on BOTH spark-bridge-master and spark-bridge-worker-1 (same file). Never commit .env.
# =============================================================================

# --- Cluster ----------------------------------------------------------------
# Private hostname (or private IP) of the master VM. Azure DNS resolves VM names
# inside the same VNet, so the VM name is usually enough.
MASTER_HOST=spark-bridge-master

# --- Storage: Azure ADLS Gen2 (storage account with hierarchical namespace ON) -
STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT=sparkbridgedemo
# All cluster state (staging, event logs, YARN logs, jobs, demo data) lives under this root
STORAGE_ROOT=abfss://spark@sparkbridgedemo.dfs.core.windows.net/spark-bridge

# Auth: "key" (fastest for a demo) or "msi" (VM managed identity, recommended)
AZURE_AUTH_MODE=key
AZURE_STORAGE_KEY=<paste-storage-account-key>
# Only for AZURE_AUTH_MODE=msi with a user-assigned identity:
# AZURE_MSI_CLIENT_ID=
# AZURE_TENANT_ID=

# --- Worker sizing (match the worker VM size) ---------------------------------
# Standard_B2ms (2 vCPU / 8 GB):  NM_MEMORY_MB=6144   NM_VCORES=2
# Standard_B4ms (4 vCPU / 16 GB): NM_MEMORY_MB=13312  NM_VCORES=4
NM_MEMORY_MB=6144
NM_VCORES=2
YARN_AM_RESOURCE_PERCENT=0.5
YARN_LOCAL_DIR_HOST=/mnt/yarn

# --- Spark job defaults (overridable per Livy request) -------------------------
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_MAX_EXECUTORS=4
