{
  "name": "SparkBridge YARN (QA)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [8998, 8088, 18080, 8042],
  "portsAttributes": {
    "8998": { "label": "Livy REST" },
    "8088": { "label": "YARN RM UI" },
    "18080": { "label": "Spark History" },
    "8042": { "label": "NodeManager UI" }
  },
  "postCreateCommand": "pip install -r src/requirements.txt",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
