{
  "name": "SparkBridge YARN (QA)",
  // GitHub's default Codespaces image: pre-cached (fast start), ships Docker-in-Docker and Python.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [8998, 8088, 18080, 8042],
  "portsAttributes": {
    "8998": { "label": "Livy REST" },
    "8088": { "label": "YARN RM UI" },
    "18080": { "label": "Spark History" },
    "8042": { "label": "NodeManager UI" }
  },
  "postCreateCommand": "pip install --user -r src/requirements.txt && docker version",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
